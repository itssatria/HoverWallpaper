<UserControl x:Class="HoverWallpaper.ZoneCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <ui:Card Padding="16" HorizontalAlignment="Stretch">
        <StackPanel>
            <Grid Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock x:Name="HeaderText" Text="Hover zone 1" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock Text="Shown while the cursor is in this zone" FontSize="12"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,0" />
                </StackPanel>
                <ui:Button x:Name="RemoveBtn" HorizontalAlignment="Right" VerticalAlignment="Top"
                           Content="Remove" Icon="{ui:SymbolIcon Delete24}" Click="Remove_Click"
                           ToolTip="Remove this hover zone" />
            </Grid>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Height="114" CornerRadius="8" ClipToBounds="True" Cursor="Hand"
                        Background="{DynamicResource ControlFillColorSecondaryBrush}"
                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1"
                        MouseLeftButtonUp="Browse_Click" ToolTip="Click to choose this zone's image">
                    <Grid>
                        <ui:SymbolIcon x:Name="ThumbPlaceholder" Symbol="Image24" FontSize="32"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        <Image x:Name="Thumb" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
                    </Grid>
                </Border>

                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock x:Name="NameText" Text="No image selected" FontWeight="Medium"
                               TextTrimming="CharacterEllipsis" ToolTip="No image selected" />
                    <TextBlock x:Name="ErrorText" Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                               TextWrapping="Wrap" Visibility="Collapsed" Margin="0,4,0,0" FontSize="12" />
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ui:Button Content="Choose image" Icon="{ui:SymbolIcon Folder24}" Click="Browse_Click" />
                        <ComboBox x:Name="FitBox" Grid.Column="2" HorizontalAlignment="Stretch"
                                  SelectionChanged="Fit_Changed" ToolTip="How this zone's image fills the screen" />
                    </Grid>
                    <ui:Button x:Name="CropBtn" Content="Adjust crop…" Icon="{ui:SymbolIcon Crop24}" Margin="0,8,0,0"
                               HorizontalAlignment="Left" Visibility="Collapsed" Click="Crop_Click" />
                </StackPanel>
            </Grid>

            <Border Height="1" Margin="0,14" Background="{DynamicResource ControlStrokeColorDefaultBrush}" />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="260" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,14">
                        <TextBlock Text="X position (%)" Margin="0,0,0,5" />
                        <ui:NumberBox x:Name="NumX" Minimum="0" Maximum="100" Value="60" MaxDecimalPlaces="0"
                                      SmallChange="1" SpinButtonPlacementMode="Inline" ValueChanged="Values_Changed" />
                    </StackPanel>
                    <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,14">
                        <TextBlock Text="Y position (%)" Margin="0,0,0,5" />
                        <ui:NumberBox x:Name="NumY" Minimum="0" Maximum="100" Value="30" MaxDecimalPlaces="0"
                                      SmallChange="1" SpinButtonPlacementMode="Inline" ValueChanged="Values_Changed" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,14">
                        <TextBlock Text="Width (%)" Margin="0,0,0,5" />
                        <ui:NumberBox x:Name="NumW" Minimum="1" Maximum="100" Value="25" MaxDecimalPlaces="0"
                                      SmallChange="1" SpinButtonPlacementMode="Inline" ValueChanged="Values_Changed" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,14">
                        <TextBlock Text="Height (%)" Margin="0,0,0,5" />
                        <ui:NumberBox x:Name="NumH" Minimum="1" Maximum="100" Value="35" MaxDecimalPlaces="0"
                                      SmallChange="1" SpinButtonPlacementMode="Inline" ValueChanged="Values_Changed" />
                    </StackPanel>
                    <ui:Button Grid.Row="2" Grid.ColumnSpan="3" Content="Open visual editor" Icon="{ui:SymbolIcon Edit24}"
                               HorizontalAlignment="Stretch" Click="VisualEditor_Click" />
                </Grid>

                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <Border x:Name="PreviewFrame" Height="146" CornerRadius="8" ClipToBounds="True" Cursor="Hand"
                            Background="{DynamicResource ControlFillColorSecondaryBrush}"
                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1"
                            MouseLeftButtonUp="VisualEditor_Click" ToolTip="Open the visual hover-area editor">
                        <Grid>
                            <TextBlock x:Name="PreviewPlaceholder" Text="Choose Image 1 to preview"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                                       TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="12" />
                            <Image x:Name="PreviewImage" Stretch="Fill" RenderOptions.BitmapScalingMode="HighQuality" />
                            <Canvas x:Name="PreviewCanvas" IsHitTestVisible="False">
                                <Border x:Name="PreviewRect" Background="#460078D4" BorderBrush="#0078D4" BorderThickness="1.5" />
                            </Canvas>
                        </Grid>
                    </Border>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ui:Card>
</UserControl>
