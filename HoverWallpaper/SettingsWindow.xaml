<ui:FluentWindow x:Class="HoverWallpaper.SettingsWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Hover Wallpaper"
                 Width="760" Height="720" MinWidth="620" MinHeight="520"
                 WindowStartupLocation="Manual"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar x:Name="TitleBar" Grid.Row="0" Title="Hover Wallpaper" ShowMaximize="False" />

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="24,10,24,20">
                <Grid Margin="0,0,0,22">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="58" Height="58" CornerRadius="14"
                            Background="{DynamicResource ControlFillColorSecondaryBrush}">
                        <Image x:Name="Logo" Width="48" Height="48" HorizontalAlignment="Center" VerticalAlignment="Center"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="16,0,0,0">
                        <TextBlock Text="Make your wallpaper interactive" FontSize="22" FontWeight="SemiBold" />
                        <TextBlock Text="Choose your scenes, then set the screen area that reveals the hover image."
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0" />
                    </StackPanel>
                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <ui:Card Grid.Column="0" Padding="16" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="Image 1" FontSize="16" FontWeight="SemiBold" />
                                    <TextBlock Text="Normal wallpaper" FontSize="12"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,0" />
                                </StackPanel>
                                <Border HorizontalAlignment="Right" VerticalAlignment="Top" CornerRadius="8"
                                        Padding="8,3" Background="{DynamicResource ControlFillColorTertiaryBrush}">
                                    <TextBlock Text="DEFAULT" FontSize="10" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </Border>
                            </Grid>
                            <Border Height="142" CornerRadius="8" ClipToBounds="True" Cursor="Hand"
                                    Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1"
                                    MouseLeftButtonUp="Browse1_Click" ToolTip="Click to choose an image">
                                <Grid>
                                    <ui:SymbolIcon x:Name="Thumb1Placeholder" Symbol="Image24" FontSize="36"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                    <Image x:Name="Thumb1" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
                                </Grid>
                            </Border>
                            <TextBlock x:Name="Name1" Text="No image selected" Margin="0,10,0,0"
                                       FontWeight="Medium" TextTrimming="CharacterEllipsis" ToolTip="No image selected" />
                            <TextBlock x:Name="Error1" Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                       TextWrapping="Wrap" Visibility="Collapsed" Margin="0,4,0,0" FontSize="12" />
                            <ui:Button Content="Choose image" Icon="{ui:SymbolIcon Folder24}" Margin="0,10,0,0"
                                       HorizontalAlignment="Stretch" Click="Browse1_Click" />
                            <TextBlock Text="Fit" Margin="0,14,0,4" FontSize="12"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <ComboBox x:Name="Fit1" HorizontalAlignment="Stretch" SelectionChanged="Fit_Changed" />
                            <ui:Button x:Name="Crop1Btn" Content="Adjust crop…" Icon="{ui:SymbolIcon Crop24}" Margin="0,8,0,0"
                                       HorizontalAlignment="Stretch" Visibility="Collapsed" Click="Crop1_Click" />
                        </StackPanel>
                    </ui:Card>

                    <ui:Card Grid.Column="2" Padding="16" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="Image 2" FontSize="16" FontWeight="SemiBold" />
                                    <TextBlock Text="Shown on hover" FontSize="12"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,0" />
                                </StackPanel>
                                <Border HorizontalAlignment="Right" VerticalAlignment="Top" CornerRadius="8"
                                        Padding="8,3" Background="{DynamicResource AccentFillColorSecondaryBrush}">
                                    <TextBlock Text="ON HOVER" FontSize="10" FontWeight="SemiBold"
                                               Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                </Border>
                            </Grid>
                            <Border Height="142" CornerRadius="8" ClipToBounds="True" Cursor="Hand"
                                    Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1"
                                    MouseLeftButtonUp="Browse2_Click" ToolTip="Click to choose an image">
                                <Grid>
                                    <ui:SymbolIcon x:Name="Thumb2Placeholder" Symbol="Image24" FontSize="36"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                    <Image x:Name="Thumb2" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
                                </Grid>
                            </Border>
                            <TextBlock x:Name="Name2" Text="No image selected" Margin="0,10,0,0"
                                       FontWeight="Medium" TextTrimming="CharacterEllipsis" ToolTip="No image selected" />
                            <TextBlock x:Name="Error2" Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                       TextWrapping="Wrap" Visibility="Collapsed" Margin="0,4,0,0" FontSize="12" />
                            <ui:Button Content="Choose image" Icon="{ui:SymbolIcon Folder24}" Margin="0,10,0,0"
                                       HorizontalAlignment="Stretch" Click="Browse2_Click" />
                            <TextBlock Text="Fit" Margin="0,14,0,4" FontSize="12"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <ComboBox x:Name="Fit2" HorizontalAlignment="Stretch" SelectionChanged="Fit_Changed" />
                            <ui:Button x:Name="Crop2Btn" Content="Adjust crop…" Icon="{ui:SymbolIcon Crop24}" Margin="0,8,0,0"
                                       HorizontalAlignment="Stretch" Visibility="Collapsed" Click="Crop2_Click" />
                        </StackPanel>
                    </ui:Card>
                </Grid>

                <Grid Margin="0,26,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Hover area" FontSize="20" FontWeight="SemiBold" />
                        <TextBlock Text="Define where your cursor reveals Image 2."
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="0,3,0,0" />
                    </StackPanel>
                    <Border Grid.Column="1" VerticalAlignment="Center" CornerRadius="8" Padding="10,5"
                            Background="{DynamicResource ControlFillColorSecondaryBrush}">
                        <TextBlock Text="SCREEN POSITION" FontSize="10" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </Border>
                </Grid>

                <ui:Card Padding="16" HorizontalAlignment="Stretch">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="260" />
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="0" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,14">
                                <TextBlock Text="X position" Margin="0,0,0,5" />
                                <ui:NumberBox x:Name="NumX" Minimum="0" Maximum="100" Value="60" MaxDecimalPlaces="0"
                                              SmallChange="1" SpinButtonPlacementMode="Inline" ValueChanged="Zone_Changed" />
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,14">
                                <TextBlock Text="Y position" Margin="0,0,0,5" />
                                <ui:NumberBox x:Name="NumY" Minimum="0" Maximum="100" Value="30" MaxDecimalPlaces="0"
                                              SmallChange="1" SpinButtonPlacementMode="Inline" ValueChanged="Zone_Changed" />
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,14">
                                <TextBlock Text="Width" Margin="0,0,0,5" />
                                <ui:NumberBox x:Name="NumW" Minimum="1" Maximum="100" Value="25" MaxDecimalPlaces="0"
                                              SmallChange="1" SpinButtonPlacementMode="Inline" ValueChanged="Zone_Changed" />
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,14">
                                <TextBlock Text="Height" Margin="0,0,0,5" />
                                <ui:NumberBox x:Name="NumH" Minimum="1" Maximum="100" Value="35" MaxDecimalPlaces="0"
                                              SmallChange="1" SpinButtonPlacementMode="Inline" ValueChanged="Zone_Changed" />
                            </StackPanel>
                            <ui:Button Grid.Row="2" Grid.ColumnSpan="3" Content="Open visual editor" Icon="{ui:SymbolIcon Edit24}"
                                       HorizontalAlignment="Stretch" Click="VisualEditor_Click" />
                        </Grid>

                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <Border x:Name="ZonePreviewFrame" Width="260" Height="146" CornerRadius="8" ClipToBounds="True" Cursor="Hand"
                                    Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1"
                                    MouseLeftButtonUp="VisualEditor_Click" ToolTip="Open visual hover-area editor">
                                <Grid>
                                    <TextBlock x:Name="ZonePlaceholder" Text="Choose Image 1 to preview"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="12" />
                                    <Image x:Name="ZoneImage" Stretch="Fill" RenderOptions.BitmapScalingMode="HighQuality" />
                                    <Canvas x:Name="ZoneCanvas" IsHitTestVisible="False">
                                        <Border x:Name="ZoneRect" Background="#460078D4" BorderBrush="#0078D4" BorderThickness="1.5" />
                                    </Canvas>
                                </Grid>
                            </Border>
                            <TextBlock Text="Click preview to adjust the hover area"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" Margin="0,7,0,0"
                                       HorizontalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </ui:Card>

                <TextBlock Text="Preferences" FontSize="20" FontWeight="SemiBold" Margin="0,26,0,12" />
                <ui:Card Padding="16" HorizontalAlignment="Stretch">
                    <ui:ToggleSwitch x:Name="StartupToggle" Content="Launch when I sign in to Windows"
                                     ToolTip="Start Hover Wallpaper automatically after you sign in." />
                </ui:Card>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Padding="24,12" Background="{DynamicResource ApplicationBackgroundBrush}"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" Grid.Column="0" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,16,0" />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <ui:Button Content="Stop" Icon="{ui:SymbolIcon Stop24}" Margin="0,0,8,0" MinWidth="90" Click="Stop_Click" />
                    <ui:Button Content="Apply" Icon="{ui:SymbolIcon Checkmark24}" Appearance="Primary" MinWidth="130" Click="Apply_Click" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
