<ui:FluentWindow x:Class="HoverWallpaper.SettingsWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Hover Wallpaper"
                 Width="760" Height="720" MinWidth="620" MinHeight="520"
                 WindowStartupLocation="Manual"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar x:Name="TitleBar" Grid.Row="0" Title="Hover Wallpaper" ShowMaximize="False" />

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="24,10,24,20">
                <Grid Margin="0,0,0,22">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="58" Height="58" CornerRadius="14"
                            Background="{DynamicResource ControlFillColorSecondaryBrush}">
                        <Image x:Name="Logo" Width="48" Height="48" HorizontalAlignment="Center" VerticalAlignment="Center"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="16,0,0,0">
                        <TextBlock Text="Make your wallpaper interactive" FontSize="22" FontWeight="SemiBold" />
                        <TextBlock Text="Choose your scenes, then set the screen area that reveals the hover image."
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0" />
                    </StackPanel>
                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <ui:Card Grid.Column="0" Padding="16" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="Image 1" FontSize="16" FontWeight="SemiBold" />
                                    <TextBlock Text="Normal wallpaper" FontSize="12"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,0" />
                                </StackPanel>
                                <Border HorizontalAlignment="Right" VerticalAlignment="Top" CornerRadius="8"
                                        Padding="8,3" Background="{DynamicResource ControlFillColorTertiaryBrush}">
                                    <TextBlock Text="DEFAULT" FontSize="10" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </Border>
                            </Grid>
                            <Border Height="142" CornerRadius="8" ClipToBounds="True" Cursor="Hand"
                                    Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1"
                                    MouseLeftButtonUp="Browse1_Click" ToolTip="Click to choose an image">
                                <Grid>
                                    <ui:SymbolIcon x:Name="Thumb1Placeholder" Symbol="Image24" FontSize="36"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                    <Image x:Name="Thumb1" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
                                </Grid>
                            </Border>
                            <TextBlock x:Name="Name1" Text="No image selected" Margin="0,10,0,0"
                                       FontWeight="Medium" TextTrimming="CharacterEllipsis" ToolTip="No image selected" />
                            <TextBlock x:Name="Error1" Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                       TextWrapping="Wrap" Visibility="Collapsed" Margin="0,4,0,0" FontSize="12" />
                            <ui:Button Content="Choose image" Icon="{ui:SymbolIcon Folder24}" Margin="0,10,0,0"
                                       HorizontalAlignment="Stretch" Click="Browse1_Click" />
                            <TextBlock Text="Fit" Margin="0,14,0,4" FontSize="12"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <ComboBox x:Name="Fit1" HorizontalAlignment="Stretch" SelectionChanged="Fit_Changed" />
                            <ui:Button x:Name="Crop1Btn" Content="Adjust crop…" Icon="{ui:SymbolIcon Crop24}" Margin="0,8,0,0"
                                       HorizontalAlignment="Stretch" Visibility="Collapsed" Click="Crop1_Click" />
                        </StackPanel>
                    </ui:Card>

                    <ui:Card Grid.Column="2" Padding="16" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                        <StackPanel>
                            <TextBlock Text="How hover zones work" FontSize="16" FontWeight="SemiBold" />
                            <TextBlock TextWrapping="Wrap" Margin="0,8,0,0" FontSize="13" LineHeight="20"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                Image 1 is always the normal wallpaper. Each hover zone has its own image and area of
                                the screen. When the cursor enters a zone, that zone's image fades in; leaving every
                                zone brings Image 1 back. If zones overlap, the first one in the list wins.
                            </TextBlock>
                            <Border Height="1" Margin="0,14" Background="{DynamicResource ControlStrokeColorDefaultBrush}" />
                            <TextBlock x:Name="ZoneCountText" Text="1 hover zone" FontWeight="SemiBold" />
                            <ui:Button Content="Add hover zone" Icon="{ui:SymbolIcon Add24}" Margin="0,10,0,0"
                                       HorizontalAlignment="Stretch" Click="AddZone_Click" />
                            <TextBlock Text="Each added zone appears below with its own image, fit and area."
                                       TextWrapping="Wrap" Margin="0,8,0,0" FontSize="12"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </ui:Card>
                </Grid>

                <Grid Margin="0,26,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Hover zones" FontSize="20" FontWeight="SemiBold" />
                        <TextBlock Text="Each zone reveals its own image while the cursor is inside it."
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="0,3,0,0" />
                    </StackPanel>
                    <Border Grid.Column="1" VerticalAlignment="Center" CornerRadius="8" Padding="10,5"
                            Background="{DynamicResource ControlFillColorSecondaryBrush}">
                        <TextBlock Text="SCREEN POSITION" FontSize="10" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </Border>
                </Grid>

                <StackPanel x:Name="ZonesPanel" />

                <TextBlock Text="Presets" FontSize="20" FontWeight="SemiBold" Margin="0,26,0,12" />
                <ui:Card x:Name="PresetsCard" Padding="16" HorizontalAlignment="Stretch">
                    <StackPanel>
                        <TextBlock TextWrapping="Wrap" FontSize="13" LineHeight="20"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                            Save the current scene — Image 1 and every hover zone with its image, fit, crop and screen
                            area — then load it again later.
                        </TextBlock>
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:TextBox x:Name="PresetName" Grid.Column="0" VerticalAlignment="Center"
                                        PlaceholderText="Preset name" MaxLength="60" KeyDown="PresetName_KeyDown" />
                            <ui:Button x:Name="SavePresetBtn" Grid.Column="2" Content="Save preset"
                                       Icon="{ui:SymbolIcon Save24}" Appearance="Primary" Click="SavePreset_Click" />
                        </Grid>
                        <TextBlock x:Name="PresetEmptyText" Text="No saved presets yet." Margin="0,14,0,0" FontSize="12"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        <ItemsControl x:Name="PresetList" Margin="0,2,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,12,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="10" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="4" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Summary}" FontSize="12" Margin="0,2,0,0"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                        <ui:Button Grid.Column="2" Content="Load" Icon="{ui:SymbolIcon Play24}"
                                                   Tag="{Binding}" Click="LoadPreset_Click"
                                                   ToolTip="Load this preset into the editor" />
                                        <ui:Button Grid.Column="4" Icon="{ui:SymbolIcon Delete24}"
                                                   Tag="{Binding}" Click="DeletePreset_Click"
                                                   ToolTip="Delete this preset" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ui:Card>

                <TextBlock Text="Preferences" FontSize="20" FontWeight="SemiBold" Margin="0,26,0,12" />
                <ui:Card Padding="16" HorizontalAlignment="Stretch">
                    <StackPanel>
                        <ui:ToggleSwitch x:Name="StartupToggle" Content="Launch when I sign in to Windows"
                                         ToolTip="Start Hover Wallpaper automatically after you sign in." />

                        <Border Height="1" Margin="0,14" Background="{DynamicResource ControlStrokeColorDefaultBrush}" />

                        <ui:ToggleSwitch x:Name="FadeToggle" Content="Fade animation between images"
                                         ToolTip="Cross-fade instead of switching instantly when the cursor enters a hover zone or leaves all zones."
                                         Checked="FadeToggle_Changed" Unchecked="FadeToggle_Changed" />

                        <Grid x:Name="FadeOptions" Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <Grid>
                                    <TextBlock Text="Fade in" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <TextBlock x:Name="FadeInValue" HorizontalAlignment="Right" FontSize="12" FontWeight="SemiBold"
                                               Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Text="250 ms" />
                                </Grid>
                                <Slider x:Name="FadeInSlider" Template="{StaticResource UiHorizontalSlider}" Margin="0,6,0,0"
                                        Minimum="0" Maximum="2000" Value="250" TickFrequency="50" IsSnapToTickEnabled="True"
                                        SmallChange="50" LargeChange="250" ValueChanged="Fade_Changed"
                                        ToolTip="How long a hover image takes to appear when the cursor enters its zone." />
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <Grid>
                                    <TextBlock Text="Fade out" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <TextBlock x:Name="FadeOutValue" HorizontalAlignment="Right" FontSize="12" FontWeight="SemiBold"
                                               Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Text="250 ms" />
                                </Grid>
                                <Slider x:Name="FadeOutSlider" Template="{StaticResource UiHorizontalSlider}" Margin="0,6,0,0"
                                        Minimum="0" Maximum="2000" Value="250" TickFrequency="50" IsSnapToTickEnabled="True"
                                        SmallChange="50" LargeChange="250" ValueChanged="Fade_Changed"
                                        ToolTip="How long Image 1 takes to come back when the cursor leaves all zones." />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ui:Card>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Padding="24,12" Background="{DynamicResource ApplicationBackgroundBrush}"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" Grid.Column="0" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,16,0" />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <ui:Button Content="Stop" Icon="{ui:SymbolIcon Stop24}" Margin="0,0,8,0" MinWidth="90" Click="Stop_Click" />
                    <ui:Button Content="Apply" Icon="{ui:SymbolIcon Checkmark24}" Appearance="Primary" MinWidth="130" Click="Apply_Click" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
